    "dreamEnabled": true,
    "lastDistillErrorPresent": true,
    "lastDreamErrorPresent": true,
    "dejaRecallRuntimeVerified": false
  },
  "backup": {
    "intervalHours": 24,
    "keep": 3,
    "includeSignIns": true,
